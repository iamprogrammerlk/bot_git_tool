[core]
  repositoryformatversion = 0
  filemode = true
  bare = false
  logallrefupdates = true
  sshCommand = ssh -i /{{PATH_TO_SSH_KEY_FILE}}/authentication.key
#
[branch "main"]
  remote = origin
  merge = refs/heads/main
  vscode-merge-base = origin/main
#
[user]
  name = {{GIT_USERNAME}}
  email = {{GIT_USER_EMAIL}}
  signingkey = /{{PATH_TO_SSH_KEY_FILE}}/signature.key
#
[gpg]
  format = ssh
#
[commit]
  gpgsign = true
#
[pull]
  rebase = false
#
[init]
  defaultBranch = main
#
[safe]
  directory = /opt/flutter
